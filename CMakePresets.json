{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug (Ninja)",
      "description": "Default Debug build with tests, examples, and benchmarks",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THREADFORGE_BUILD_TESTS": "ON",
        "THREADFORGE_BUILD_EXAMPLES": "ON",
        "THREADFORGE_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "description": "Optimized Release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THREADFORGE_BUILD_TESTS": "ON",
        "THREADFORGE_BUILD_EXAMPLES": "ON",
        "THREADFORGE_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Address & UB Sanitizers",
      "description": "Debug build with ASan and UBSan enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THREADFORGE_ENABLE_ASAN_UBSAN": "ON",
        "THREADFORGE_BUILD_TESTS": "ON",
        "THREADFORGE_BUILD_EXAMPLES": "ON",
        "THREADFORGE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "description": "Debug build with ThreadSanitizer enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THREADFORGE_ENABLE_TSAN": "ON",
        "THREADFORGE_BUILD_TESTS": "ON",
        "THREADFORGE_BUILD_EXAMPLES": "ON",
        "THREADFORGE_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
